<!DOCTYPE html>
<html lang="ko">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Liquid Information — Archive</title>


<style>

/* =========================
   기본
========================= */

* {
    box-sizing: border-box;
}

body {

    margin: 0;

    background: #f3f3f3;

    color: #111;

    font-family:
        Arial,
        Helvetica,
        sans-serif;
}


/* =========================
   헤더
========================= */

header {

    padding: 30px;

    background: white;

    border-bottom: 1px solid #ddd;

}

header h1 {

    margin: 0;

    font-size: 22px;

    font-weight: 500;

}

header p {

    margin: 8px 0 0;

    color: #777;

    font-size: 13px;

}


/* =========================
   메인
========================= */

main {

    max-width: 1200px;

    margin: 40px auto;

    padding: 0 25px;

}


/* =========================
   업로드 영역
========================= */

#dropZone {

    width: 100%;

    min-height: 260px;

    background: white;

    border:
        1px dashed #999;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    cursor: pointer;

    transition: 0.2s;

}


#dropZone:hover {

    background: #fafafa;

}


#dropZone.dragover {

    border:
        2px solid #111;

    background: #eee;

}


.uploadText {

    pointer-events: none;

}


.uploadText h2 {

    margin: 0 0 10px;

    font-size: 18px;

    font-weight: 400;

}


.uploadText p {

    margin: 0;

    color: #888;

    font-size: 13px;

}


#fileInput {

    display: none;

}


/* =========================
   툴바
========================= */

.toolbar {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin: 25px 0 15px;

}


.pageCount {

    font-size: 13px;

